{
  "name": "dsh-plugin-api-wallet",
  "version": "1.0.0",
  "description": "Show live API wallet balances (DeepSeek, Moonshot, OpenRouter, SiliconFlow…) in the DeepSeek Harness composer, following the model you use.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "balance",
    "wallet",
    "api-key"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaishaoshao/dsh-plugin-api-wallet.git"
  },
  "homepage": "https://github.com/kaishaoshao/dsh-plugin-api-wallet#readme",
  "bugs": {
    "url": "https://github.com/kaishaoshao/dsh-plugin-api-wallet/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
